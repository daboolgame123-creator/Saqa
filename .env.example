# متغيرات بيئة الـBackend (Phase 8).
# تُقرأ مباشرة من بيئة العملية (process.env) — لا يوجد تحميل تلقائي لملف .env.
# اضبطها في بيئة الطرفية أو في خدمة التشغيل عند الحاجة إلى تغيير القيم الافتراضية.

# بيئة التشغيل: development (افتراضي) | production | test
NODE_ENV=development

# منفذ HTTP server الخاص بالـBackend (الافتراضي 4000 — واجهة Vite على 3000)
PORT=4000

# أدنى مستوى يُكتب في السجل التقني المهيكل: debug | info (افتراضي) | warn | error
LOG_LEVEL=info
