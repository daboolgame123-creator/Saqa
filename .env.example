# متغيرات بيئة الـBackend (Phase 8 — وُسّعت في Phase 9 بإعدادات قاعدة البيانات).
# تُقرأ مباشرة من بيئة العملية (process.env) — لا يوجد تحميل تلقائي لملف .env.
# اضبطها في بيئة الطرفية أو في خدمة التشغيل عند الحاجة إلى تغيير القيم الافتراضية.

# بيئة التشغيل: development (افتراضي) | production | test
NODE_ENV=development

# منفذ HTTP server الخاص بالـBackend (الافتراضي 4000 — واجهة Vite على 3000)
PORT=4000

# أدنى مستوى يُكتب في السجل التقني المهيكل: debug | info (افتراضي) | warn | error
LOG_LEVEL=info

# ── قاعدة البيانات (Phase 9) ─────────────────────────────────────────────
# رابط PostgreSQL للتطوير/التشغيل — اختياري في هذه المرحلة (لا يُشترط لتشغيل
# الخادم)، ويصبح إلزيمياً مع Phase 10 عند تفعيل API. قيمته حساسة ولا تُطبع
# أبداً في السجلات. أنشئ القاعدة يدوياً ثم طبّق الـMigrations:
#   npm run db:dev        (PostgreSQL مدمج محلياً — بدون تثبيت نظام)
#   npm run db:migrate    ثم  npm run db:rollback عند الحاجة
DATABASE_URL=postgres://alsqaya:alsqaya_dev@127.0.0.1:5433/alsqaya_dev
# ملاحظة الترميز: العنقود يجب أن يكون UTF8 (وليس WIN1256)، وإلا رفض حفظ
# الأرقام العربية الهندية في أرقام الكتب.

# رابط قاعدة الاختبار المعزولة — للاختبارات فقط (تُدار آلياً في
# server/tests/db ولا تُستخدم بيانات حقيقية إطلاقاً). اتركه فارغاً
# ليعمل الاختبار على قاعدة alsqaya_test المؤقتة عبر embedded-postgres.
TEST_DATABASE_URL=

# ── الواجهة (Phase 10) ────────────────────────────────────────────────
# هذه المتغيرات لحزمة المتصفح وتقرأ وقت البناء عبر Vite. أي متغير
# لا يبدأ بـVITE_ لا يصل إلى الواجهة ولا يصلح لحفظ سر.
#
# جذر مسارات الـAPI (الافتراضي منفذ Phase 8 على 4000).
VITE_API_BASE_URL=http://127.0.0.1:4000/api

# نمط مصدر البيانات: api (الافتراضي) | local (localStorage للتطوير بلا خادم).
VITE_DATA_SOURCE=api
